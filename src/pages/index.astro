---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Gallery from "../components/Gallery.astro";
import Pricing from "../components/Pricing.astro";
import CoreSection from "../components/CoreSection.astro";
import Footer from "../components/Footer.astro";
import { site, whatsapp } from "../data/site";
import { screens } from "../data/showcase";
const hero =
  screens.find((s) => s.id === "07-dashboard-barber-bikingos") ?? screens[0];
const beauty = screens.find((s) => s.id === "10-dashboard-beauty-king");
const branding = screens.find((s) => s.id === "06-configuracion-marca-barber");
const features = [
  [
    "01",
    "Agenda digital",
    "Cada cita, en su lugar.",
    "Consulta disponibilidad, organiza citas y conecta la atención de tus clientes con el trabajo de tu equipo.",
  ],
  [
    "02",
    "Personal y servicios",
    "Una operación coordinada.",
    "Administra tu equipo, sus horarios y los servicios que dan identidad a tu negocio.",
  ],
  [
    "03",
    "Clientes",
    "Conoce a quienes vuelven.",
    "Mantén organizada la información de tus clientes desde el panel administrativo.",
  ],
  [
    "04",
    "Reportes",
    "Decisiones con perspectiva.",
    "Consulta la actividad del negocio, los estados de las citas y los servicios registrados.",
  ],
];
---

<Layout
  title="TrimmOS V3 Chromatic Flow — Software para Barber & Beauty"
  description="Organiza citas, personal, clientes y servicios con TrimmOS. Software para Barber & Beauty desarrollado por Hesed Core. Comienza 30 días gratis."
>
  <Header />
  <main id="contenido">
    <section class="hero wrap" id="inicio" aria-labelledby="hero-title">
      <div class="hero-kicker">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span> TrimmOS V3 / Chromatic Flow
        </p>
        <span class="mono hero-edition">BARBER & BEAUTY SOFTWARE</span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">
            Tu negocio
            <br />
            tiene talento.
            <br />
            <span>
              Dale el control
              <br />
              que merece.
            </span>
          </h1>
          <p class="hero-description">
            Gestiona citas, equipo, servicios, clientes y crecimiento desde una
            plataforma diseñada para barberías y salones de belleza.
          </p>
          <div class="hero-actions">
            <a class="button" href={whatsapp()}>
              Comenzar 30 días gratis <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#producto">
              Explorar TrimmOS <span aria-hidden="true">↓</span>
            </a>
          </div>
          <a class="byline" href={site.corporate}>
            <img src="/brand/hesed.png" alt="" width="25" height="25" />
            Un producto de <strong>Hesed Core</strong> ↗
          </a>
        </div>
        <div class="hero-visual">
          <div class="hero-visual-label">
            <span class="mono">TU ESTILO. TU OPERACIÓN.</span>
            <span class="pill">El control se ve así</span>
          </div>
          <div class="hero-product">
            {hero && (
              <img
                src={hero.image}
                width={hero.width}
                height={hero.height}
                alt={hero.alt}
                fetchpriority="high"
              />
            )}
            <div class="hero-product-caption">
              <span>01 / Panel Barber</span>
              <a href="#producto">
                Explora el producto <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          {beauty && (
            <div class="beauty-peek">
              <img
                src={beauty.image}
                width={beauty.width}
                height={beauty.height}
                alt={beauty.alt}
                loading="lazy"
              />
              <span>También con tu esencia Beauty.</span>
            </div>
          )}
          <div class="hero-note">
            <span class="spark" aria-hidden="true">
              ✳
            </span>
            <p>
              Menos improvisación.
              <br />
              <strong>Más espacio para tu talento.</strong>
            </p>
          </div>
        </div>
      </div>
      <div class="hero-foot">
        <span>Diseñado para el ritmo de tu negocio</span>
        <div>
          <span>Agenda</span>
          <span>Equipo</span>
          <span>Clientes</span>
          <span>Identidad</span>
        </div>
        <a href="#producto" aria-label="Bajar a explorar el producto">
          ↓
        </a>
      </div>
    </section>
    <Gallery />
    <section
      class="section wrap features-section"
      id="funcionalidades"
      aria-labelledby="features-title"
    >
      <div class="section-heading">
        <p class="eyebrow">02 / Del día a día al siguiente nivel</p>
        <h2 id="features-title">
          Todo tiene su lugar.
          <br />
          <em>También tu crecimiento.</em>
        </h2>
        <p>
          De la primera reservación al cierre del día, una vista más clara de tu
          operación.
        </p>
      </div>
      <div class="feature-list">
        {features.map(([number, label, title, description]) => (
          <article>
            <span class="mono feature-number">{number}</span>
            <div>
              <p class="eyebrow">{label}</p>
              <h3>{title}</h3>
            </div>
            <p>{description}</p>
            <span class="feature-arrow" aria-hidden="true">
              ↗
            </span>
          </article>
        ))}
      </div>
      <div class="booking-strip">
        <span class="booking-icon" aria-hidden="true">
          ↗
        </span>
        <div>
          <h3>Tu agenda, al alcance de tus clientes.</h3>
          <p>
            Comparte el enlace de reservaciones o el código QR de tu
            establecimiento.
          </p>
        </div>
        <a class="text-link" href="#producto">
          Ver reservaciones →
        </a>
      </div>
    </section>
    <section
      class="modes-section"
      id="barber-beauty"
      aria-labelledby="modes-title"
    >
      <div class="wrap">
        <div class="section-heading">
          <p class="eyebrow">03 / Dos mundos. Tu identidad.</p>
          <h2 id="modes-title">
            Precisión Barber.
            <br />
            <em>Esencia Beauty.</em>
          </h2>
          <p>
            Cada negocio tiene su forma de hacer las cosas. TrimmOS tiene un
            espacio para la tuya.
          </p>
        </div>
        <div class="modes-grid">
          <article class="mode barber-mode">
            <span class="mono">01 / BARBER</span>
            <h3>
              Carácter.
              <br />
              Precisión.
              <br />
              <em>Control.</em>
            </h3>
            <p>
              El pulso de tu barbería en un panel: citas del día, servicios y
              equipo para acompañar tu operación.
            </p>
            <a href="#producto" class="text-link">
              Explorar Barber ↗
            </a>
            <span class="mode-mark" aria-hidden="true">
              B/
            </span>
          </article>
          <article class="mode beauty-mode">
            <span class="mono">02 / BEAUTY</span>
            <h3>
              Identidad.
              <br />
              Experiencia.
              <br />
              <em>Organización.</em>
            </h3>
            <p>
              Una experiencia para tu salón, con servicios, equipo e identidad
              visual que reflejan tu esencia.
            </p>
            <a href="#producto" class="text-link">
              Explorar Beauty ↗
            </a>
            <span class="mode-mark" aria-hidden="true">
              /B
            </span>
          </article>
        </div>
        <p class="modes-note">
          Elige Barber o Beauty con Essential. Combina ambas modalidades con
          Pro.
        </p>
      </div>
    </section>
    <section
      class="section wrap identity-section"
      id="personalizacion"
      aria-labelledby="identity-title"
    >
      <div class="identity-copy">
        <p class="eyebrow">04 / Hecho para llevar tu firma</p>
        <h2 id="identity-title">
          Tu marca.
          <br />
          Tus colores.
          <br />
          <em>Tu TrimmOS.</em>
        </h2>
        <p>
          La tecnología también puede hablar tu idioma visual. Personaliza los
          colores y la información de tu establecimiento para que la experiencia
          se sienta tuya.
        </p>
        <div class="color-swatches" aria-label="Ejemplos de acentos de marca">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
        <a class="text-link" href="#producto">
          Descubrir personalización ↗
        </a>
      </div>
      <figure class="identity-visual">
        {branding && (
          <img
            src={branding.image}
            alt={branding.alt}
            width={branding.width}
            height={branding.height}
            loading="lazy"
          />
        )}
        <figcaption>
          <span class="mono">CONFIGURACIÓN DE MARCA</span>
          <span>Una plataforma. Identidades distintas.</span>
        </figcaption>
      </figure>
    </section>
    <CoreSection />
    <Pricing />
    <section class="backing-section">
      <div class="wrap backing-grid">
        <a class="corporate-mark" href={site.corporate}>
          <img src="/brand/hesed.png" alt="" width="72" height="72" />
          <span>
            HESED
            <br />
            <strong>CORE</strong>
          </span>
        </a>
        <div>
          <p class="eyebrow">07 / El equipo detrás del producto</p>
          <h2>
            Ingeniería de Software
            <br />
            <em>con Propósito.</em>
          </h2>
          <p>
            TrimmOS es un producto desarrollado por Hesed Core. Construimos
            tecnología con una visión clara: acompañar la evolución de los
            negocios con software útil y mantenible.
          </p>
          <a class="text-link" href={site.corporate}>
            Conoce a Hesed Core ↗
          </a>
        </div>
        <span class="backing-seal mono">
          SECURITY
          <br />
          BY CULTURE
        </span>
      </div>
    </section>
    <section class="final-cta">
      <div class="wrap">
        <p class="eyebrow">Tu siguiente etapa empieza aquí</p>
        <h2>
          El siguiente nivel de tu negocio comienza con{" "}
          <em>mejores decisiones.</em>
        </h2>
        <div>
          <a class="button button-light" href={whatsapp()}>
            Comienza con TrimmOS <span aria-hidden="true">↗</span>
          </a>
          <p>
            30 días gratis.
            <br />
            Hablemos de tu negocio.
          </p>
        </div>
        <span class="final-word" aria-hidden="true">
          NEXT.
        </span>
      </div>
    </section>
  </main>
  <Footer />
  <a
    class="floating-contact"
    href={whatsapp("contact")}
    aria-label="Contactar a TrimmOS por WhatsApp"
  >
    <span aria-hidden="true">↗</span>
    <span>Hablemos</span>
  </a>
  <script>
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduceMotion && "IntersectionObserver" in window) {
      const targets = [
        ...document.querySelectorAll<HTMLElement>(
          "main section, .feature-list article, .mode, .plan, .identity-visual",
        ),
      ];
      targets.forEach((target, index) => {
        target.classList.add("reveal");
        target.style.setProperty("--reveal-delay", `${(index % 4) * 70}ms`);
      });
      document.documentElement.classList.add("motion-ready");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -36px 0px" },
      );
      targets.forEach((target) => observer.observe(target));
    }
  </script>
</Layout>
