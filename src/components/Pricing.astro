---
import { whatsapp } from "../data/site";
const plans = [
  {
    name: "Lanzamiento",
    price: "Gratis",
    unit: "durante 30 días",
    description: "Conoce TrimmOS en el ritmo real de tu negocio.",
    features: [
      "30 días para explorar la plataforma",
      "Contacto directo con Hesed Core",
    ],
    cta: "Obtener 30 días gratis",
    action: "trial" as const,
  },
  {
    name: "Essential",
    price: "$399",
    unit: "MXN / mes",
    description: "Tu especialidad, con una operación organizada.",
    features: ["Una sucursal", "Modalidad Barber o Beauty"],
    cta: "Activar Essential",
    action: "essential" as const,
  },
  {
    name: "Pro",
    price: "$599",
    unit: "MXN / mes",
    description: "Dos especialidades. Una misma visión de negocio.",
    features: ["Barber + Beauty en un mismo plan", "Una sucursal"],
    cta: "Activar Pro",
    action: "pro" as const,
  },
];
---

<section class="section wrap" id="planes" aria-labelledby="plans-title">
  <div class="section-heading">
    <p class="eyebrow">06 / A tu ritmo</p>
    <h2 id="plans-title">
      Un siguiente paso.
      <br />
      Un plan para ti.
    </h2>
    <p>
      Empieza con 30 días gratis. Elige la modalidad que acompaña a tu negocio.
    </p>
  </div>
  <div class="plans">
    {plans.map((plan, i) => (
      <article class:list={["plan", { "plan-pro": i === 2 }]}>
        <div class="plan-top">
          <span class="mono">0{i + 1}</span>
          {i === 2 && <span class="tag">Barber + Beauty</span>}
        </div>
        <h3>{plan.name}</h3>
        <p>{plan.description}</p>
        <div class="price">{plan.price}</div>
        <p class="price-unit">{plan.unit}</p>
        <ul>
          {plan.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
        <a
          class:list={["button", { "button-outline": i !== 2 }]}
          href={whatsapp(plan.action)}
        >
          {plan.cta}
          <span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>
  <p class="plan-note">
    ¿Tu negocio crece?{" "}
    <strong>Sucursal adicional desde $100 MXN por local.</strong> Sujeto a
    condiciones comerciales vigentes.
  </p>
  <p class="fine-print">
    La prueba y la activación de planes se coordinan por WhatsApp con nuestro
    equipo.
  </p>
</section>
